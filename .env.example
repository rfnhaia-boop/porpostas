# Copie para .env e ajuste
DATABASE_URL="postgresql://nex_quotes:nex_quotes_dev@localhost:5435/nex_quotes?schema=public"

# Better Auth — gere o secret com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="troque-por-um-secret-aleatorio"
BETTER_AUTH_URL="http://localhost:3001"

# Login com Google — opcional. Sem preencher, o botão "Entrar com Google" some.
# Google Cloud Console → Credentials → OAuth Client ID (Web application).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — opcional. Sem RESEND_API_KEY o app só usa notificação in-app.
RESEND_API_KEY=""
RESEND_FROM="NEX Quotes <onboarding@resend.dev>"
APP_URL="http://localhost:3001"
